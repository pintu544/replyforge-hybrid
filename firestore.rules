rules_version = '2';

// ReplyForge Hybrid — per-user partition (DESIGN.md).
// Every private record lives under users/{uid}/... and only its owner may
// read or write it. There are no shared collections in Slice 1.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
