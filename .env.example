# ReplyForge Hybrid — local environment (copy to .env and fill in; .env is gitignored)
# Values come from Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: Firebase App Check debug token for LOCAL development only.
# Generate one in the browser console on first run (see Firebase App Check docs),
# register it in the console under App Check → Apps → Manage debug tokens.
# Never commit a real token.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Cloud model used by Firebase AI Logic for in-cloud inference.
VITE_CLOUD_MODEL=gemini-2.5-flash
